"UnlitGeneric"
{
	"$basetexture" "freak_fortress_2/freddy_fuckboy/water_overlay_1"
	$alphatest "0"
	$translucent "1"
	$nolod "1"
	$ignorez    "1"


	"Proxies" 
	{ 
		"AnimatedTexture" 
		{
			"animatedTextureVar" "$basetexture" 
			"animatedTextureFrameNumVar" "$frame" 
			"animatedTextureFrameRate" "1"
		 } 
	} 
}